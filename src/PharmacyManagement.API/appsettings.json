{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=PharmacyManagement;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Secret": "ChangeThisDevelopmentSecretKeyToSomethingLongAndSecure123!",
    "Issuer": "PharmacyManagement.Api",
    "Audience": "PharmacyManagement.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Seed": {
    "AdminEmail": "admin@pharmacy.local",
    "AdminPassword": "Admin@12345"
  },
  "Storage": {
    "RootPath": "wwwroot/uploads"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/api-.log", "rollingInterval": "Day" } }
    ]
  },
  "AllowedHosts": "*"
}
